<Window x:Class="GitAutoBackup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:GitAutoBackup.ViewModels"
        xmlns:views="clr-namespace:GitAutoBackup.Views"
        xmlns:term="clr-namespace:EasyWindowsTerminalControl;assembly=EasyWindowsTerminalControl"
        Title="GitAutoBackup - 图形化 Git 备份工具"
        Height="820" Width="1040"
        MinHeight="640" MinWidth="900"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- 页面 VM -> View 的映射，用于导航切换 -->
        <DataTemplate DataType="{x:Type vm:MainViewModel}">
            <views:TasksView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ConsolidatedViewModel}">
            <views:ConsolidatedView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StandaloneViewModel}">
            <views:StandaloneView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReposViewModel}">
            <views:ReposView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ExcludesViewModel}">
            <views:ExcludesView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ScheduleViewModel}">
            <views:ScheduleView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AboutViewModel}">
            <views:AboutView/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左侧导航（整列，从顶到底，不被日志/状态栏占用） -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBg}" BorderBrush="{StaticResource BorderLight}" BorderThickness="0,0,1,0">
            <DockPanel>
                <TextBlock Text="GitAutoBackup" FontWeight="Bold" FontSize="16"
                           Margin="18,22,18,18" DockPanel.Dock="Top" Foreground="{StaticResource TextPrimary}"/>
                <ListBox ItemsSource="{Binding NavItems}"
                         SelectedItem="{Binding SelectedNavItem}"
                         BorderThickness="0" Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Margin" Value="10,2"/>
                            <Setter Property="Padding" Value="12,9"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="bd" CornerRadius="8" Background="Transparent" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="{StaticResource HoverBg}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentBg}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource AccentText}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Title}" FontSize="13"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- 右侧：页面内容 + 底部面板 + 状态栏 -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 页面内容 -->
            <ScrollViewer Grid.Row="0" Margin="8" VerticalScrollBarVisibility="Auto" Background="{StaticResource AppBg}">
                <ContentControl Content="{Binding CurrentPage}"/>
            </ScrollViewer>

            <!-- 底部面板（日志 / 终端，可最小化） -->
            <Border Grid.Row="1" Background="{StaticResource AppBg}" BorderBrush="{StaticResource BorderLight}" BorderThickness="0,1,0,0"
                    Visibility="{Binding IsLogVisible, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <!-- 标题栏：标签切换 + 收起图标 -->
                    <Border DockPanel.Dock="Top" Background="{StaticResource SidebarBg}" Padding="6,2">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                <Button Content="日志" Command="{Binding ShowLogPanelCommand}" Background="Transparent" BorderThickness="0" Padding="10,4" Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                                            <Setter Property="FontWeight" Value="Normal"/>
                                            <Setter Property="FontSize" Value="12"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsTerminalPanel}" Value="False">
                                                    <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="终端" Command="{Binding ShowTerminalPanelCommand}" Background="Transparent" BorderThickness="0" Padding="10,4" Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                                            <Setter Property="FontWeight" Value="Normal"/>
                                            <Setter Property="FontSize" Value="12"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsTerminalPanel}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                            <Button DockPanel.Dock="Right" ToolTip="最小化" Command="{Binding ToggleLogCommand}"
                                    Background="Transparent" BorderThickness="0" Padding="6" Cursor="Hand"
                                    HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Path Data="M0,0 L6,5 L12,0" Stroke="{StaticResource TextSecondary}" StrokeThickness="1.6"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            </Button>
                        </DockPanel>
                    </Border>
                    <!-- 内容：日志 或 终端 -->
                    <Grid>
                        <TextBox Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 FontFamily="Consolas" FontSize="12" Height="180" TextWrapping="NoWrap"
                                 Background="{StaticResource PanelBg}" Foreground="{StaticResource TextPrimary}"
                                 BorderThickness="0" Padding="8,6"
                                 Visibility="{Binding IsTerminalPanel, Converter={StaticResource InverseBoolToVis}}"/>
                        <Border Padding="8,6" Background="{StaticResource AppBg}"
                                Visibility="{Binding IsTerminalPanel, Converter={StaticResource BoolToVis}}">
                            <term:EasyTerminalControl x:Name="TerminalControl"
                                                      StartupCommandLine="powershell.exe"
                                                      FontFamilyWhenSettingTheme="Consolas"
                                                      FontSizeWhenSettingTheme="11"
                                                      Height="180"/>
                        </Border>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- 状态栏 -->
            <Border Grid.Row="2" Background="{StaticResource SidebarBg}" BorderBrush="{StaticResource BorderLight}" BorderThickness="0,1,0,0" Padding="10,5">
                <DockPanel>
                    <!-- 展开日志（日志收起时显示） -->
                    <Button DockPanel.Dock="Right" ToolTip="展开日志" Command="{Binding ShowLogCommand}"
                            Background="Transparent" BorderThickness="0" Padding="6" Cursor="Hand" VerticalAlignment="Center">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLogVisible}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Path Data="M0,5 L6,0 L12,5" Stroke="{StaticResource TextSecondary}" StrokeThickness="1.6"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                    </Button>

                    <!-- 环境检查（git / gh CLI）：正常显示状态，缺失时点击打开官方下载页 -->
                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Padding="10,4" Margin="0,0,8,0"
                            Command="{Binding EnvActionCommand}"
                            ToolTip="点击重新检测运行环境；若缺失则打开官方下载页">
                        <TextBlock Text="{Binding EnvStatusText}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#A32D2D"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding EnvOk}" Value="True">
                                            <Setter Property="Foreground" Value="#0F6E56"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>

                    <Button DockPanel.Dock="Left" Content="日志" Style="{StaticResource GhostButton}" Padding="12,4"
                            Command="{Binding ToggleLogCommand}"/>
                    <ProgressBar DockPanel.Dock="Left" Width="120" Height="4" IsIndeterminate="True"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                                 VerticalAlignment="Center" Margin="12,0,0,0"/>
                    <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
