<UserControl x:Class="GitAutoBackup.Views.StandaloneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 新增 + 反馈 -->
        <Border Grid.Row="0" Padding="14" CornerRadius="12" Background="{StaticResource PanelBg}"
                BorderBrush="{StaticResource BorderLight}" BorderThickness="1" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="新增独立式项目" FontWeight="Bold" Margin="0,0,0,8"/>
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" LineHeight="20"
                           Foreground="{StaticResource TextSecondary}" Margin="0,0,0,10"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="仓库名:" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding RepoName, UpdateSourceTrigger=PropertyChanged}" Width="200" Margin="6,0"
                             ToolTip="留空则使用项目名作为仓库名"/>
                    <TextBlock Text="可见性:" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    <ComboBox ItemsSource="{Binding VisibilityOptions}" SelectedValuePath="Key" SelectedValue="{Binding IsPrivate}"
                              Width="90" Margin="6,0">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Value}" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
                <Button Content="选择文件夹并新增" Command="{Binding AddCommand}"
                        Style="{StaticResource AccentButton}" HorizontalAlignment="Left" Padding="16,6"/>
            </StackPanel>
        </Border>

        <!-- 现有独立式项目列表 -->
        <GroupBox Grid.Row="1" Header="现有独立式项目" Padding="6">
            <DataGrid ItemsSource="{Binding Jobs}" AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="项目名" Binding="{Binding ProjectName}" IsReadOnly="True" Width="150"/>
                    <DataGridTextColumn Header="源路径" Binding="{Binding SourcePath}" IsReadOnly="True" Width="*"/>
                    <DataGridTextColumn Header="仓库名" Binding="{Binding RepoName}" IsReadOnly="True" Width="140"/>
                    <DataGridTextColumn Header="状态" Binding="{Binding LastStatus}" IsReadOnly="True" Width="110"/>
                    <DataGridTextColumn Header="最近备份" Binding="{Binding LastBackupAt, StringFormat={}{0:MM-dd HH:mm}}" IsReadOnly="True" Width="110"/>
                    <DataGridTemplateColumn Header="操作" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="删除" Style="{StaticResource GhostButton}" Padding="8,2"
                                        Command="{Binding DataContext.DeleteJobCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>
    </Grid>
</UserControl>
