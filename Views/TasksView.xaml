<UserControl x:Class="GitAutoBackup.Views.TasksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="4">
        <!-- 任务列表 -->
        <GroupBox Header="备份任务" Padding="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Content="－ 删除当前行" Style="{StaticResource GhostButton}" Command="{Binding RemoveJobCommand}" Margin="8,0,0,0" Padding="10,3"
                            ToolTip="删除表格中当前高亮的那一行任务"/>
                    <Button Content="备份选中项目" Style="{StaticResource AccentButton}" Command="{Binding RunSelectedCommand}" Margin="8,0,0,0" Padding="14,3"
                            ToolTip="只备份「备份」列已勾选（= 选中）的项目，可多选"/>
                    <Button Content="立即备份全部" Style="{StaticResource GhostButton}" Command="{Binding RunAllCommand}" Margin="8,0,0,0" Padding="10,3"
                            ToolTip="不管是否勾选，备份列表里的所有任务"/>
                    <TextBlock Text="勾选「备份」列 = 选中该项目（可多选；点行也能切换勾选）"
                               Foreground="{StaticResource TextSecondary}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <DataGrid Grid.Row="1" x:Name="TaskGrid" AutoGenerateColumns="False" IsReadOnly="False"
                          SelectionMode="Single"
                          PreviewMouseLeftButtonDown="TaskGrid_PreviewMouseLeftButtonDown"
                          ItemsSource="{Binding Jobs}" SelectedItem="{Binding SelectedJob}"
                          CanUserAddRows="False" CanUserDeleteRows="False">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="备份" Width="50">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <!-- 用模板列替代 DataGridCheckBoxColumn：后者单击只进入编辑态，需双击才切换 -->
                                    <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Click="BackupCheck_Click"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="项目名" Binding="{Binding ProjectName}" IsReadOnly="True" Width="150"/>
                        <DataGridTextColumn Header="源路径" Binding="{Binding SourcePath}" IsReadOnly="True" Width="*"/>
                        <DataGridTextColumn Header="方式" Binding="{Binding ModeText}" IsReadOnly="True" Width="160"/>
                        <DataGridTextColumn Header="集中仓库名" Binding="{Binding ConsolidatedRepoName}" IsReadOnly="True" Width="140"/>
                        <DataGridTextColumn Header="独立仓库名" Binding="{Binding RepoName}" Width="140" IsReadOnly="True"/>
                        <DataGridTextColumn Header="状态" Binding="{Binding LastStatus}" IsReadOnly="True" Width="110"/>
                        <DataGridTextColumn Header="最近备份" Binding="{Binding LastBackupAt, StringFormat={}{0:MM-dd HH:mm}}" IsReadOnly="True" Width="110"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </GroupBox>
    </Grid>
</UserControl>
