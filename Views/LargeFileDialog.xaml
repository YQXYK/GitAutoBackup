<Window x:Class="GitAutoBackup.Views.LargeFileDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="发现超过 GitHub 上限的文件" Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource AppBg}">
    <StackPanel Margin="20">
        <TextBlock x:Name="HeadlineText" FontWeight="Bold" FontSize="15" TextWrapping="Wrap" Margin="0,0,0,8"/>
        <TextBlock x:Name="ExplainText" TextWrapping="Wrap" LineHeight="21"
                   Foreground="{StaticResource TextSecondary}" Margin="0,0,0,14"/>

        <TextBlock Text="将被跳过的文件" FontWeight="Bold" Margin="0,0,0,6"/>
        <Border CornerRadius="8" Background="{StaticResource PanelBg}"
                BorderBrush="{StaticResource BorderLight}" BorderThickness="1">
            <ListBox x:Name="FilesList" MaxHeight="190" BorderThickness="0"
                     Background="Transparent" Padding="4"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding RelativePath}" FontSize="12"
                                       TextTrimming="CharacterEllipsis" Margin="2,1,10,1"/>
                            <TextBlock Grid.Column="1" Text="{Binding SizeText}" FontSize="12"
                                       FontFamily="Consolas" Foreground="{StaticResource TextSecondary}"
                                       Margin="0,1,2,1"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <TextBlock x:Name="TotalText" FontSize="12" Foreground="{StaticResource TextSecondary}"
                   Margin="0,8,0,0" TextWrapping="Wrap"/>

        <TextBlock x:Name="WarningText" FontSize="12" Foreground="{StaticResource TextSecondary}"
                   Margin="0,8,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>

        <CheckBox x:Name="ApplyAllCheck" Content="本批次其余项目也这样处理，不再逐个询问"
                  Margin="0,14,0,0" FontSize="12"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="取消备份" Style="{StaticResource GhostButton}" Click="Cancel_Click"
                    Padding="16,6" Margin="0,0,8,0" IsCancel="True"/>
            <Button Content="跳过并继续" Style="{StaticResource AccentButton}" Click="Skip_Click"
                    Padding="16,6" IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</Window>
