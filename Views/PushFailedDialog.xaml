<Window x:Class="GitAutoBackup.Views.PushFailedDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="备份失败" Width="540" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource AppBg}">
    <StackPanel Margin="20">
        <TextBlock x:Name="TitleText" FontWeight="Bold" FontSize="15" TextWrapping="Wrap"
                   Foreground="#A32D2D" Margin="0,0,0,10"/>

        <TextBlock x:Name="ExplainText" TextWrapping="Wrap" LineHeight="21" Margin="0,0,0,14"/>

        <Border CornerRadius="8" Background="{StaticResource PanelBg}"
                BorderBrush="{StaticResource BorderLight}" BorderThickness="1"
                Padding="12,10" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="可以这样处理" FontWeight="Bold" FontSize="12"
                           Foreground="{StaticResource TextSecondary}" Margin="0,0,0,5"/>
                <TextBlock x:Name="SuggestionText" TextWrapping="Wrap" LineHeight="21"/>
            </StackPanel>
        </Border>

        <Expander Header="查看原始错误信息（可复制给开发者）" FontSize="12"
                  Foreground="{StaticResource TextSecondary}">
            <TextBox x:Name="RawText" IsReadOnly="True" TextWrapping="Wrap" Height="120"
                     VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11"
                     Background="{StaticResource PanelBg}" BorderBrush="{StaticResource BorderLight}"
                     Foreground="{StaticResource TextPrimary}" Margin="0,8,0,0" Padding="6"/>
        </Expander>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="知道了" Style="{StaticResource GhostButton}" Click="Close_Click"
                    Padding="16,6" IsCancel="True"/>
            <Button x:Name="RetryButton" Content="重试" Style="{StaticResource AccentButton}"
                    Click="Retry_Click" Padding="16,6" Margin="8,0,0,0" IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</Window>
